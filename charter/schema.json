{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://astrid.box/charter/schema.json",
  "title": "Astrid charter (compiled JSON form), format v1",
  "type": "object",
  "required": ["charter_version", "revision", "identity", "substrate", "network",
               "services", "autonomy", "invariants", "goals", "brain",
               "firewall", "backups"],
  "additionalProperties": false,
  "properties": {
    "charter_version": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "identity": {
      "type": "object",
      "required": ["name", "role"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "tailscale": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$" },
        "lineage": { "type": "string" }
      }
    },
    "substrate": {
      "type": "object",
      "required": ["os", "kernel"],
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string" },
        "kernel": { "type": "string" },
        "seat": { "type": "string" },
        "boot": { "type": "object", "additionalProperties": true }
      }
    },
    "disks": {
      "type": "object",
      "required": ["physical"],
      "properties": {
        "physical": { "type": "array", "items": { "type": "object" } },
        "logical": { "type": "object", "additionalProperties": true },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "required": ["interfaces"],
      "additionalProperties": false,
      "properties": {
        "interfaces": { "type": "object", "additionalProperties": { "type": "object" } },
        "management_plane": { "type": "string" },
        "exposure": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["listen", "bind"],
            "additionalProperties": false,
            "properties": {
              "listen": { "type": "string", "pattern": "^[0-9]+/tcp$" },
              "bind": { "type": "string" }
            }
          }
        }
      }
    },
    "firewall": {
      "type": "object",
      "required": ["engine", "policy"],
      "additionalProperties": false,
      "properties": {
        "engine": { "type": "string" },
        "policy": { "type": "object" },
        "inbound": { "type": "array", "items": { "type": "string" } }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string" } } }
    },
    "packages_extra": {
      "type": "object",
      "additionalProperties": true
    },
    "secrets": {
      "type": "object",
      "required": ["principle"],
      "additionalProperties": false,
      "properties": {
        "principle": { "type": "string" },
        "on_box": { "type": "string" }
      }
    },
    "users": {
      "type": "array",
      "items": { "type": "object", "required": ["name", "type"], "properties": { "name": { "type": "string" }, "type": { "type": "string" }, "sudo": { "type": "string" } }, "additionalProperties": false }
    },
    "backups": {
      "type": "object",
      "required": ["timer", "unit"],
      "additionalProperties": false,
      "properties": {
        "timer": { "type": "string" },
        "unit": { "type": "string" },
        "payload": { "type": "string" },
        "off_box": { "type": "string" }
      }
    },
    "brain": {
      "type": "object",
      "required": ["stem"],
      "additionalProperties": false,
      "properties": {
        "stem": { "type": "object" },
        "assistant_brain": { "type": "object" },
        "face": { "type": "string" },
        "architect": { "type": "string" }
      }
    },
    "autonomy": {
      "type": "object",
      "required": ["default", "domains"],
      "additionalProperties": false,
      "properties": {
        "default": { "enum": ["L0", "L1", "L2", "L3"] },
        "domains": {
          "type": "object",
          "additionalProperties": { "enum": ["L0", "L1", "L2", "L3", "L0 "] }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 15 }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^G[0-9]+$" },
          "text": { "type": "string" },
          "status": { "type": "string", "pattern": "^(open|closed|shipped)" }
        }
      }
    }
  }
}
